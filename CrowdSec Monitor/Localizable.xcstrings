    "An error occurred while deleting the server. This could mean that the database is corrupted. Please try deleting the server again. If the problem persists, uninstall the application and install it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server konnte nicht gelöscht werden. Möglicherweise ist die Datenbank beschädigt. Versuche es erneut. Bleibt das Problem, deinstalliere die App und installiere sie neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ocurrido un error al eliminar el servidor. Esto puede significar que la base de datos está corrupta. Por favor, prueba de nuevo. Si el problema persiste, desinstala la aplicación e instálala de nuevo."
          }
        }
