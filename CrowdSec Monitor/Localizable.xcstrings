        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refrescar una lista de bloqueo es una tarea pesada a nivel de computo que necesita hasta varios minutos para completarse. No refresques las listas muy frecuentemente. ¿Deseas continuar?"
