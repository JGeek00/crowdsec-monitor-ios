    "Give the channel a name, optionally send a test notification, then finish to save it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle un nombre al canal, opcionalmente envía una notificación de prueba y finaliza para guardarlo."
